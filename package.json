{
  "name": "hdr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "./.conda-env/bin/uvicorn server.app:app --host 127.0.0.1 --port 8001 --reload --reload-exclude '.conda-env/*' --reload-exclude 'reference/*' --reload-exclude 'index/*'",
    "dev:all": "concurrently -k -n web,rs3 -c blue,green \"npm:dev\" \"npm:dev:api\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.2.1",
    "oxlint": "^1.71.0",
    "vite": "^5.4.19"
  }
}
